{
  "name": "@resilience-network/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical codecs, hashes and validated Chain RPC clients for Resilience Network",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Resilience-Network/sdk.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js"
    },
    "./display": {
      "types": "./dist/display/index.d.ts",
      "import": "./dist/display/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "docs:check": "python3 scripts/check_docs.py",
    "build": "node scripts/clean.mjs && tsc",
    "package:check": "node scripts/check_package.mjs",
    "check": "npm run format:check && npm run typecheck && npm run docs:check && npm test && npm run package:check",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:differential": "npm run build && node scripts/check_differential.mjs && node scripts/check_receipts.mjs",
    "test:rpc-native": "node scripts/check_rpc_contracts.mjs",
    "test:signatures-native": "npm run build && node scripts/check_signatures.mjs",
    "test:receipts-native": "npm run build && node scripts/check_receipts.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
